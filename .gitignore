# --- Godot 4 ---
.godot/
/android/
*.translation
export_presets.cfg
/build/
/exports/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv*/
venv*/
env/
.pytest_cache/

# --- Vision dev artifacts ---
# Recorded sessions & calibration are machine-specific.
# Keep a small sample clip if you want one; ignore the rest.
/recordings/
/captures/
/vision/models/
calibration.local.json
*.mp4
*.avi

# --- Editors / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Local agent/session state ---
.remember/
.claude/

# Audio is never committed: the click track is regenerated with
# tools/make_click_track.py, real songs (hand-authored or GH-converted) are
# dropped in locally (see game/audio/README.md).
game/audio/*
!game/audio/README.md

# --- Local GH/Clone Hero song folders (source material for
# tools/gh_chart_convert.py) - other people's copyrighted content, never ours
# to commit. game/charts/*.json is a separate, tracked thing: this only
# ignores the raw song folders at the repo root.
/charts/
