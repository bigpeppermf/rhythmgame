# --- Godot 4 ---
.godot/
/android/
*.translation
export_presets.cfg
/build/
/exports/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/

# --- Vision dev artifacts ---
# Recorded sessions & calibration are machine-specific.
# Keep a small sample clip if you want one; ignore the rest.
/recordings/
/captures/
calibration.local.json
*.mp4
*.avi

# --- Editors / OS ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- Local agent/session state ---
.remember/
.claude/

# Audio is never committed: the click track is regenerated with
# tools/make_click_track.py, real songs (hand-authored or GH-converted) are
# dropped in locally (see game/audio/README.md).
game/audio/*
!game/audio/README.md
